<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.springframework.org/schema/context"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
		http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-4.3.xsd">

	<!-- spring-servlet.xml -->

	<context:annotation-config />

	<!-- user class instance(object) create -->
	<bean class="com.kosa.controller.GiftAllController"
		id="giftAllController" />
	<bean class="com.kosa.controller.InsertGiftController"
		id="insertGiftController" />
	<bean class="com.kosa.controller.DeleteGiftController"
		id="deleteGiftController" />


	<!-- ViewResolver 빈 객체 생성 -->
	<bean
		class="org.springframework.web.servlet.view.InternalResourceViewResolver">
		<property name="prefix">
			<value>/WEB-INF/views/</value>
		</property>
		<property name="suffix" value=".jsp" />

	</bean>

	<context:component-scan
		base-package="com.kosa.model"></context:component-scan>

</beans>
